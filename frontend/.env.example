# Vite exposes VITE_* values in the browser bundle.
# Only the Supabase anon/publishable key is allowed here. Never add service-role,
# database credentials, or the OpenAI API key to frontend environment variables.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=
